# Copy this file to .env and add your own credentials. Never commit .env.

# AI learning coach: Claude, through the official Anthropic SDK.
# Create a key in the Claude Console (API keys) and make sure the account has API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional fallback: any OpenAI-compatible provider (used only when ANTHROPIC_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: require this password for the whole site (leave empty for local use).
APP_PASSWORD=
